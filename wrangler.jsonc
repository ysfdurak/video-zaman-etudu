// Cloudflare Workers: tarayıcı sürümünü (Web/) statik site olarak yayınlar.
// Sunucu kodu yoktur; yalnız statik dosyalar sunulur. Depo Cloudflare'e bağlandığında
// main dalına her gönderimde otomatik yayın yapılır.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-zaman-etudu",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./Web",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "zaman-etudu.ysfdurak.com", "custom_domain": true }
  ],
  // PR önizlemeleri (Workers Builds → npx wrangler preview) bu bölümü ister. Proje yalnızca statik
  // dosya sunduğu için önizlemenin ayrı bir ayarı yok; bölüm bilerek boş.
  "previews": {}
}
